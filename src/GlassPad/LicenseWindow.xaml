<Window x:Class="GlassPad.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassPad — Open-source licenses"
        Width="760" Height="600" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="#1A1A2E"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#202038" />
            <Setter Property="Foreground" Value="#EEF2FF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Open-source licenses" Foreground="White" FontSize="22"
                   FontWeight="SemiBold" Margin="0,0,0,16" />
        <TabControl Grid.Row="1" Padding="0" Background="#202038" BorderThickness="0">
            <TabItem Header="GlassPad" Padding="14,8">
                <TextBox x:Name="GlassPadLicense" AutomationProperties.Name="GlassPad MIT license" />
            </TabItem>
            <TabItem Header="HIDMaestro" Padding="14,8" IsSelected="True">
                <TextBox x:Name="HIDMaestroLicense" AutomationProperties.Name="HIDMaestro MIT license" />
            </TabItem>
            <TabItem Header="Third-party notices" Padding="14,8">
                <TextBox x:Name="ThirdPartyNotices" AutomationProperties.Name="HIDMaestro third-party notices" />
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" Content="Close" Width="100" Height="34"
                HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
